# Leave empty to use same-origin (/api, /socket.io) — correct for Vite dev proxy and for Nginx production.
# Or provide explicit URLs (e.g. https://api.yourdomain.com) if deploying to different domains.
VITE_API_URL=
VITE_SOCKET_URL=

# Where `npm run dev` proxies API/websocket traffic (Vite development server only).
VITE_DEV_API_TARGET=http://127.0.0.1:8787

# Application branding and upload limits
VITE_APP_NAME=Zentrix Pulse
VITE_MAX_UPLOAD_FILES=100
